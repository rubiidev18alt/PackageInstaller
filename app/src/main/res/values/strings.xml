    <string name="open_developer_options">Open developer options</string>
    <string name="adb_instructions">In Developer options → Wireless debugging: tap “Pair device with pairing code” to show the pairing port and code (keep that dialog open, use split-screen). The connection port is shown on the main Wireless debugging screen.</string>

    <string name="root_title">Root (su)</string>
    <string name="root_desc">For rooted devices. Uses su to run pm directly.</string>
