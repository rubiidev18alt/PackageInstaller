    <string name="adb_title">Wireless ADB (on-device)</string>
    <string name="adb_desc">Android 11+. Enable Wireless debugging, pair once with a pairing code, then connect — all on this device, no PC needed.</string>
    <string name="adb_not_paired">Not paired</string>
    <string name="adb_paired">Paired — not connected</string>
