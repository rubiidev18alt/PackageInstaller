    <!-- Main screen -->
    <string name="hero_title">Install an app</string>
    <string name="hero_subtitle">Pick an APK or a split bundle (APKS / XAPK / APKM). You can also open APK files from any file manager and choose Shell Installer.</string>
    <string name="choose_file">Choose APK or bundle</string>
    <string name="backend_section">Install backend</string>
    <string name="backend_section_hint">Installs run as the shell user (like adb install), so they skip the on-device “unknown sources” / advanced sideloading flow.</string>

    <string name="shizuku_title">Shizuku</string>
